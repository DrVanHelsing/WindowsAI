<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedConversations"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups, Mode=OneWay}" />
    </Page.Resources>

    <Grid Padding="28,24,28,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="History" />

        <!-- Saved conversations, grouped by recency -->
        <ListView
            x:Name="ConversationList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="Conversation_ItemClick"
            ItemsSource="{x:Bind GroupedConversations.View, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="None">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:ConversationGroup">
                            <TextBlock
                                Margin="2,8,0,2"
                                FontSize="11"
                                CharacterSpacing="60"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{x:Bind Key}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True" />
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationSummary">
                    <Border
                        Padding="16,12"
                        Background="{StaticResource GlassFillSubtleBrush}"
                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}"
                        PointerEntered="Row_PointerEntered"
                        PointerExited="Row_PointerExited">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="{x:Bind Snippet}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextGhostBrush}"
                                    Text="{x:Bind Meta}" />
                            </StackPanel>

                            <!-- Row actions — quiet until the row is hovered; each opens a modal -->
                            <StackPanel
                                x:Name="RowActions"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Opacity="0.35"
                                Orientation="Horizontal"
                                Spacing="2">
                                <StackPanel.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </StackPanel.OpacityTransition>
                                <Button
                                    Click="Rename_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Rename">
                                    <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                </Button>
                                <Button
                                    Click="Delete_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Delete">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{StaticResource TextGhostBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="No saved conversations yet" />
            <TextBlock
                MaxWidth="360"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="Conversations are saved automatically once you start chatting."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
