<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsAI_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:providers="using:WindowsAI.Core.Providers"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedModels"
            IsSourceGrouped="True"
            Source="{x:Bind Groups, Mode=OneWay}" />
    </Page.Resources>

    <Grid Padding="28,24,28,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Models &amp; providers" />
                <ProgressRing
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{StaticResource GlassFillSubtleBrush}"
                BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                BorderThickness="1"
                Click="Refresh_Click"
                CornerRadius="{StaticResource RadiusMedium}"
                Foreground="{StaticResource TextSecondaryBrush}"
                ToolTipService.ToolTip="Refresh model list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    <TextBlock FontSize="13" Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!--  ── PROVIDERS ──  -->
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            CharacterSpacing="60"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="PROVIDERS" />
                        <Button
                            HorizontalAlignment="Right"
                            Click="AddProvider_Click"
                            Content="+ Add provider"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <!--  Empty state  -->
                    <Border
                        Padding="20,18"
                        Style="{StaticResource GlassCardSubtleStyle}"
                        Visibility="{x:Bind Providers.HasProviders, Mode=OneWay, Converter={StaticResource InvBoolToVisConverter}}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="No providers yet" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Add a cloud provider (paste an API key or sign in) or a local one (Ollama) to start chatting." />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind Providers.Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderConnectionViewModel">
                                <Border Margin="0,4" Padding="16,14" Style="{StaticResource GlassCardStyle}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource AccentFillSubtleBrush}"
                                            BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{StaticResource AccentTextBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse
                                                    Width="9"
                                                    Height="9"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{x:Bind DisplayName}" />
                                                <Border
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource GlassFillSubtleBrush}"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{StaticResource TextTertiaryBrush}"
                                                        Text="{x:Bind KindLabel}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind Endpoint}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="{x:Bind StatusText, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <ToggleSwitch
                                                MinWidth="0"
                                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                OffContent=""
                                                OnContent=""
                                                Toggled="ProviderEnabled_Toggled" />
                                            <Button
                                                Click="ProviderSignIn_Click"
                                                Content="Sign in"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind IsGoogleSignIn, Converter={StaticResource BoolToVisConverter}}" />
                                            <Button Click="ProviderTest_Click" Content="Test" />
                                            <Button Click="ProviderEdit_Click" Content="Edit" />
                                            <Button Click="ProviderRemove_Click" Content="Remove" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  ── MODELS ──  -->
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="13"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="MODELS — pick your default chat model" />

                    <ListView
                        x:Name="ModelList"
                        ItemsSource="{x:Bind GroupedModels.View, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:ModelGroup">
                                        <TextBlock
                                            Margin="2,8,0,2"
                                            FontSize="11"
                                            CharacterSpacing="60"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Text="{x:Bind Key}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,12" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="providers:ModelOption">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentFillSubtleBrush}"
                                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}">
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{StaticResource AccentTextBrush}"
                                            Glyph="{x:Bind local:ModelsPage.GlyphFor(IsLocal)}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Text="{x:Bind Key}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource GlassFillSubtleBrush}"
                                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{x:Bind Kind}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
