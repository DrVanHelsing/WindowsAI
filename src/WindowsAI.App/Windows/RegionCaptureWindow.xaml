<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.Windows.RegionCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsAI_App.Controls">

    <!--
        Visual-intelligence region capture. Fullscreen over the monitor under the cursor: shows the
        frozen screenshot, dims everything, and lets the user drag a selection that "spotlights" the
        chosen region. On release it crops the region and reveals the ask card, which streams a vision
        model's answer. Driven entirely from code-behind (no x:Bind converters) — see the project's
        silent-XamlCompiler-error note.
    -->
    <Grid x:Name="RootHost" Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.12" />
            </Storyboard>
        </Grid.Resources>

        <!-- Frozen screenshot of the captured monitor -->
        <Image x:Name="ScreenImage" Stretch="Fill" />

        <!-- Selection layer: dimming scrims + the selection box. Transparent so it gets pointer input. -->
        <Canvas
            x:Name="Overlay"
            Background="Transparent"
            PointerPressed="Overlay_PointerPressed"
            PointerMoved="Overlay_PointerMoved"
            PointerReleased="Overlay_PointerReleased">

            <!-- Full dim before a selection is drawn -->
            <Rectangle x:Name="FullScrim" Fill="#9A000000" />

            <!-- Four scrims surrounding the selection (the gap between them is the bright spotlight) -->
            <Rectangle x:Name="ScrimTop" Fill="#9A000000" Visibility="Collapsed" />
            <Rectangle x:Name="ScrimBottom" Fill="#9A000000" Visibility="Collapsed" />
            <Rectangle x:Name="ScrimLeft" Fill="#9A000000" Visibility="Collapsed" />
            <Rectangle x:Name="ScrimRight" Fill="#9A000000" Visibility="Collapsed" />

            <!-- The selection outline -->
            <Border
                x:Name="SelectionBox"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="2"
                Visibility="Collapsed" />

            <!-- Live dimensions readout next to the selection -->
            <Border
                x:Name="SizeHintCard"
                Padding="6,3"
                Background="#CC000000"
                CornerRadius="4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SizeHint"
                    FontSize="12"
                    Foreground="White" />
            </Border>
        </Canvas>

        <!-- Top hint banner -->
        <Border
            x:Name="HintBanner"
            Margin="0,28,0,0"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayScrimBrush}"
            CornerRadius="{StaticResource RadiusMedium}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:SparkleIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Drag to select a region to ask about" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="·  Esc to cancel" />
            </StackPanel>
        </Border>

        <!-- ── Ask card (revealed after a region is captured) ── -->
        <Grid
            x:Name="AskOverlay"
            Background="#B3000000"
            Visibility="Collapsed">
            <Border
                Width="460"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource AccentStrokeBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid Margin="18,16,18,16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:SparkleIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Ask about this region" />
                        </StackPanel>
                        <Button
                            x:Name="CloseButton"
                            Padding="8"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Close_Click"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <!-- Captured thumbnail -->
                    <Border
                        Grid.Row="1"
                        MaxHeight="160"
                        Padding="6"
                        HorizontalAlignment="Stretch"
                        Background="#40000000"
                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}">
                        <Image
                            x:Name="ThumbImage"
                            MaxHeight="148"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform" />
                    </Border>

                    <!-- Question input -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="QuestionBox"
                            Grid.Column="0"
                            KeyDown="QuestionBox_KeyDown"
                            PlaceholderText="Ask anything… (or press Ask to describe it)" />
                        <Button
                            x:Name="AskButton"
                            Grid.Column="1"
                            Padding="18,8"
                            BorderThickness="0"
                            Click="Ask_Click"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Foreground="White">
                            <Button.Resources>
                                <!--  Keep the iris fill across states (default template otherwise grays it on hover)  -->
                                <StaticResource x:Key="ButtonBackground" ResourceKey="AccentBrush" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#828DFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5A66E0" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0FFFFFF" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="13" Foreground="White" Glyph="&#xE8BD;" />
                                <TextBlock FontSize="14" Text="Ask" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Answer -->
                    <Border
                        Grid.Row="3"
                        MinHeight="60"
                        Padding="12,10"
                        Background="{StaticResource GlassFillElevatedBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="AnswerText"
                                    FontSize="14"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                            <StackPanel
                                x:Name="ThinkingRow"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    Foreground="{StaticResource AccentBrush}"
                                    IsActive="True" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="Looking…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
