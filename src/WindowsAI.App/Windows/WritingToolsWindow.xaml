<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.Windows.WritingToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsAI_App.Controls">

    <!--
        Type-anywhere writing-tools popup. Real titlebar window with Mica backdrop (set in code-behind);
        this root Grid is the readability scrim over the Mica. Content is driven from code-behind
        (action buttons built from WritingAction.All, result streamed in) so there are no x:Bind
        converters in this Window XAML — see the project's silent-XamlCompiler-error note.

        IsTabStop so the root can take focus on open and the Esc accelerator fires before any click.
    -->
    <Grid
        x:Name="RootHost"
        Background="{StaticResource OverlayScrimBrush}"
        IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide" Y="-8" />
        </Grid.RenderTransform>

        <Grid.Resources>
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootSlide"
                    Storyboard.TargetProperty="Y"
                    To="0"
                    Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.14" />
            </Storyboard>

            <!-- Action row in the menu state -->
            <Style x:Key="WritingActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </Grid.Resources>

        <!-- Specular sheen over the whole card (non-interactive, so it never blocks the drag region) -->
        <Rectangle
            Grid.RowSpan="2"
            Fill="{StaticResource GlassSheenBrush}"
            IsHitTestVisible="False" />

        <!--  ── Title bar (drag region; brand mark + name live here, not duplicated in the body) ──  -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Padding="14,0,0,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <controls:SparkleIcon
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Writing tools" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="16,2,16,16"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Selected-text preview ── -->
            <Border
                x:Name="PreviewBorder"
                Grid.Row="0"
                Padding="10,8"
                Background="{StaticResource GlassFillSubtleBrush}"
                BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}">
                <TextBlock
                    x:Name="SelectionPreview"
                    MaxLines="2"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Border>

            <!-- ── Actions state: free-form Ask box on top of the preset transforms ── -->
            <Grid x:Name="ActionsState" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Ask: type a custom request about the selection -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="AskBox"
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="False"
                        KeyDown="AskBox_KeyDown"
                        PlaceholderText="Ask anything about the selection…" />
                    <Button
                        x:Name="AskButton"
                        Grid.Column="1"
                        Padding="14,8"
                        BorderThickness="0"
                        Click="Ask_Click"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Foreground="White"
                        ToolTipService.ToolTip="Ask about the selection">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackground" ResourceKey="AccentBrush" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#828DFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5A66E0" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0FFFFFF" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Foreground="White" Glyph="&#xE8BD;" />
                            <TextBlock FontSize="14" Text="Ask" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer
                    x:Name="ActionsScroller"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ActionsPanel" Spacing="6">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Notice state (no selection / capture failed / error) ── -->
            <StackPanel
                x:Name="NoticePanel"
                Grid.Row="1"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    x:Name="NoticeText"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- ── Result state ── -->
            <Grid x:Name="ResultPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="12,10"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="ResultText"
                                FontSize="14"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <!-- Thinking indicator while the model streams -->
                        <StackPanel
                            x:Name="ThinkingRow"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                Foreground="{StaticResource AccentBrush}"
                                IsActive="True" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Thinking…" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Result actions -->
                <Grid Grid.Row="1" Margin="0,10,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Padding="10,8"
                        Background="{StaticResource GlassFillSubtleBrush}"
                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                        BorderThickness="1"
                        Click="Back_Click"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        AutomationProperties.Name="Back to actions"
                        ToolTipService.ToolTip="Back to actions">
                        <FontIcon FontSize="13" Glyph="&#xE72B;" />
                    </Button>

                    <Button
                        x:Name="CopyButton"
                        Grid.Column="1"
                        Padding="10,8"
                        Background="{StaticResource GlassFillSubtleBrush}"
                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                        BorderThickness="1"
                        Click="Copy_Click"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        AutomationProperties.Name="Copy result"
                        ToolTipService.ToolTip="Copy result">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                    </Button>

                    <Button
                        x:Name="ReplaceButton"
                        Grid.Column="3"
                        Padding="16,8"
                        BorderThickness="0"
                        Click="Replace_Click"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Foreground="White">
                        <Button.Resources>
                            <!--  Keep the iris fill across states (default template otherwise grays it on hover)  -->
                            <StaticResource x:Key="ButtonBackground" ResourceKey="AccentBrush" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#828DFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5A66E0" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F0FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2E6E7BFF" />
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#80FFFFFF" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Foreground="White" Glyph="&#xE8E5;" />
                            <TextBlock FontSize="14" Text="Replace" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!--  The card's edge is the native window frame (titlebar window) — no self-drawn border.  -->
    </Grid>
</Window>
