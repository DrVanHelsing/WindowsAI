<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.Windows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    xmlns:conv="using:WindowsAI_App.Converters"
    xmlns:controls="using:WindowsAI_App.Controls">

    <!--
        Left-edge slide-in panel. Full screen height, 420 logical px wide.
        The window backdrop is fully transparent (TransparentBackdrop in code-behind);
        this root Grid's Background is the readability scrim — lower the alpha for more
        see-through, raise it for more contrast.
        NOTE (Window XAML): no x:Bind Converter= here — use conv:Vis function binds.
    -->
    <Grid x:Name="RootHost" Background="#B30D0A1C" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide" X="-440" />
        </Grid.RenderTransform>

        <Grid.Resources>

            <!-- Show: slide in from left with a slight spring overshoot + fade -->
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootSlide"
                    Storyboard.TargetProperty="X"
                    To="0"
                    Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.16" />
            </Storyboard>

            <!-- Dismiss: slide out to left + fade -->
            <Storyboard x:Name="DismissStoryboard" Completed="DismissStoryboard_Completed">
                <DoubleAnimation
                    Storyboard.TargetName="RootSlide"
                    Storyboard.TargetProperty="X"
                    To="-440"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.14" />
            </Storyboard>

            <!-- Running light: the comet gradient orbits the panel frame during inference.
                 Gradient-transform animation is dependent (CPU-ticked) by design. -->
            <Storyboard x:Name="ThinkingSpinStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation
                    EnableDependentAnimation="True"
                    Storyboard.TargetName="ThinkingSpin"
                    Storyboard.TargetProperty="Angle"
                    From="0"
                    To="360"
                    Duration="0:0:1.6" />
            </Storyboard>

            <!-- Quiet glass action row (recents / suggestions) -->
            <Style x:Key="OverlayActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

        </Grid.Resources>

        <!-- Panel-wide specular sheen: top-down light falloff over the glass -->
        <Rectangle Fill="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />

        <!-- Panel content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Search pill + new chat ──────────────────────────── -->
            <Grid Grid.Row="0" Margin="18,20,18,14" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                <Border
                    x:Name="SearchPillBorder"
                    Height="52"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="26" />
                <!-- Inner specular highlight on the upper half of the pill -->
                <Border
                    Height="52"
                    Background="{StaticResource GlassSheenBrush}"
                    CornerRadius="26"
                    IsHitTestVisible="False" />
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand sparkle — spins + twinkles during inference -->
                    <controls:SparkleIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="2,0,10,0"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        KeyDown="SearchBox_KeyDown"
                        PlaceholderText="Ask anything…"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <!--  Local-RAG toggle: include matching files from this PC  -->
                    <ToggleButton
                        x:Name="LocalContextToggle"
                        Grid.Column="2"
                        Padding="8"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Checked="LocalContext_Toggled"
                        CornerRadius="16"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        ToolTipService.ToolTip="Search my PC files for context"
                        Unchecked="LocalContext_Toggled">
                        <FontIcon FontSize="13" Glyph="&#xE721;" />
                    </ToggleButton>
                </Grid>
                </Grid>

                <!-- New chat: clears the conversation, returns to the empty state -->
                <Button
                    Grid.Column="1"
                    Width="52"
                    Height="52"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.NewConversationCommand}"
                    CornerRadius="26"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    ToolTipService.ToolTip="New chat">
                    <FontIcon FontSize="17" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <!-- ── Body: messages OR empty state ───────────────────── -->
            <Grid Grid.Row="1">

                <!-- Messages -->
                <ListView
                    x:Name="ResultsList"
                    Padding="16,4,16,10"
                    ItemsSource="{x:Bind ViewModel.Messages}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Grid Margin="0,4">
                                <!--  User message — right-aligned indigo glass capsule  -->
                                <Border
                                    MaxWidth="310"
                                    HorizontalAlignment="Right"
                                    Padding="14,9"
                                    Background="{StaticResource UserBubbleFillBrush}"
                                    BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16,16,5,16"
                                    Visibility="{x:Bind conv:Vis.If(IsUser)}">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="White"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <!--  AI message — markdown prose with indigo accent bar  -->
                                <StackPanel HorizontalAlignment="Stretch" Spacing="4" Visibility="{x:Bind conv:Vis.IfNot(IsUser)}">
                                    <Grid>
                                        <Rectangle
                                            Width="3"
                                            Margin="0,4,0,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Fill="{StaticResource AccentBrush}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                        <controls:MessageContentControl Margin="14,0,0,0" Text="{x:Bind Text, Mode=OneWay}" />
                                    </Grid>

                                    <!--  Local files used as context — horizontally scrollable strip  -->
                                    <ScrollViewer
                                        Margin="14,2,0,0"
                                        HorizontalScrollBarVisibility="Hidden"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled"
                                        Visibility="{x:Bind conv:Vis.If(HasSources), Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind Sources, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{Binding Path}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon
                                                                FontSize="12"
                                                                Foreground="{StaticResource AccentTextBrush}"
                                                                Glyph="&#xE7C3;" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state: recents + quick actions -->
                <StackPanel
                    x:Name="EmptyPanel"
                    Margin="16,8,16,0"
                    VerticalAlignment="Top"
                    Spacing="8">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <TextBlock
                        x:Name="RecentsLabel"
                        Margin="4,4,0,0"
                        FontSize="11"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="RECENT"
                        Visibility="Collapsed" />

                    <ItemsControl x:Name="RecentsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Click="Recent_Click"
                                    Style="{StaticResource OverlayActionButtonStyle}"
                                    Tag="{Binding Id}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Text="{Binding Meta}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="4,10,0,0"
                        FontSize="11"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="TRY" />

                    <Button
                        Click="Suggestion_Click"
                        Style="{StaticResource OverlayActionButtonStyle}"
                        Tag="Summarize this for me: ">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Foreground="{StaticResource AccentTextBrush}" Glyph="&#xE8BC;" />
                            <TextBlock Text="Summarize a block of text" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="Suggestion_Click"
                        Style="{StaticResource OverlayActionButtonStyle}"
                        Tag="Translate this to English: ">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Foreground="{StaticResource AccentTextBrush}" Glyph="&#xE775;" />
                            <TextBlock Text="Translate something" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="Suggestion_Click"
                        Style="{StaticResource OverlayActionButtonStyle}"
                        Tag="Write a one-line PowerShell command to ">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="13" Foreground="{StaticResource AccentTextBrush}" Glyph="&#xE756;" />
                            <TextBlock Text="Get a PowerShell one-liner" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Footer ──────────────────────────────────────────── -->
            <Border
                Grid.Row="2"
                Padding="18,14"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Privacy / model badge  -->
                    <Border
                        Grid.Column="0"
                        Padding="11,6"
                        Background="{StaticResource GlassFillSubtleBrush}"
                        BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ProgressRing
                                Width="10"
                                Height="10"
                                Foreground="{StaticResource AccentBrush}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <FontIcon
                                FontSize="10"
                                Foreground="{StaticResource AccentBrush}"
                                Glyph="&#xE72E;"
                                Visibility="{x:Bind conv:Vis.IfNot(ViewModel.IsBusy), Mode=OneWay}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ModelLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Keyboard hint  -->
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TextGhostBrush}"
                        Text="Alt+Space · Esc" />

                    <!--  Open the full app  -->
                    <Button
                        Grid.Column="2"
                        Click="OpenApp_Click"
                        Style="{StaticResource OverlayActionButtonStyle}"
                        CornerRadius="{StaticResource RadiusPill}"
                        Padding="12,6"
                        ToolTipService.ToolTip="Open WindowsAI">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                            <TextBlock FontSize="11" Text="Open app" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>

        <!-- Inner depth shadow along the right edge — panel reads as floating glass -->
        <Rectangle
            Width="12"
            HorizontalAlignment="Right"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#46000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Edge-lit hairline at the very right -->
        <Rectangle
            Width="1"
            HorizontalAlignment="Right"
            Opacity="0.14">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="Transparent" />
                    <GradientStop Offset="0.15" Color="White" />
                    <GradientStop Offset="0.85" Color="White" />
                    <GradientStop Offset="1.0" Color="Transparent" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Thinking frame: a rainbow comet orbits the panel edge while the LLM works.
             The rotating gradient sweeps a bright band along the 2.5px border. -->
        <Border
            x:Name="ThinkingFrame"
            BorderThickness="2.5"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Border.OpacityTransition>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="ThinkingSpin" CenterX="0.5" CenterY="0.5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Offset="0.0" Color="#004F8CFF" />
                    <GradientStop Offset="0.38" Color="#004F8CFF" />
                    <GradientStop Offset="0.46" Color="#FF4F8CFF" />
                    <GradientStop Offset="0.50" Color="#FFFF6BD6" />
                    <GradientStop Offset="0.54" Color="#FF4DE3FF" />
                    <GradientStop Offset="0.62" Color="#004DE3FF" />
                    <GradientStop Offset="1.0" Color="#004DE3FF" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

    </Grid>
</Window>
