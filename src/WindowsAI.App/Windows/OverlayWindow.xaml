<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.Windows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    xmlns:conv="using:WindowsAI_App.Converters"
    xmlns:controls="using:WindowsAI_App.Controls">

    <!--
        Left-edge slide-in panel. Full screen height, 420 logical px wide.
        The window backdrop is fully transparent (TransparentBackdrop in code-behind);
        this root Grid's Background is the readability scrim — lower the alpha for more
        see-through, raise it for more contrast.
        NOTE (Window XAML): no x:Bind Converter= here — use conv:Vis function binds.
    -->
    <Grid
        x:Name="RootHost"
        AllowDrop="True"
        Background="{StaticResource OverlayScrimBrush}"
        DragLeave="RootHost_DragLeave"
        DragOver="RootHost_DragOver"
        Drop="RootHost_Drop"
        Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide" X="-440" />
        </Grid.RenderTransform>

        <Grid.Resources>

            <!-- Show: slide in from left with a slight spring overshoot + fade -->
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootSlide"
                    Storyboard.TargetProperty="X"
                    To="0"
                    Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.16" />
            </Storyboard>

            <!-- Dismiss: slide out to left + fade -->
            <Storyboard x:Name="DismissStoryboard" Completed="DismissStoryboard_Completed">
                <DoubleAnimation
                    Storyboard.TargetName="RootSlide"
                    Storyboard.TargetProperty="X"
                    To="-440"
                    Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="RootHost"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.14" />
            </Storyboard>

            <!-- Thinking pulse: the persistent accent edge gently breathes while the LLM
                 works (replaces the old orbiting rainbow comet). -->
            <Storyboard x:Name="ThinkingPulseStoryboard" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="AccentFrame"
                    Storyboard.TargetProperty="Opacity"
                    From="0.5"
                    To="1.0"
                    Duration="0:0:0.9">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Quiet glass action row (recents / suggestions) -->
            <Style x:Key="OverlayActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

        </Grid.Resources>

        <!-- Panel-wide specular sheen: top-down light falloff over the glass -->
        <Rectangle Fill="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />

        <!-- Panel content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Pending attachments (drag-dropped files) sit between the search bar and the body  -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Search pill + new chat ──────────────────────────── -->
            <Grid Grid.Row="0" Margin="18,20,18,14" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                <Border
                    x:Name="SearchPillBorder"
                    Height="52"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="26" />
                <!-- Inner specular highlight on the upper half of the pill -->
                <Border
                    Height="52"
                    Background="{StaticResource GlassSheenBrush}"
                    CornerRadius="26"
                    IsHitTestVisible="False" />
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand sparkle — spins + twinkles during inference -->
                    <controls:SparkleIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="2,0,10,0"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        SelectionHighlightColor="{StaticResource AccentBrush}"
                        KeyDown="SearchBox_KeyDown"
                        PlaceholderText="Ask anything…"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <!--  Go: same action as Enter (open best match / ask the AI)  -->
                    <Button
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentFillMediumBrush}"
                        BorderBrush="{StaticResource AccentStrokeBrush}"
                        BorderThickness="1"
                        Click="Go_Click"
                        CornerRadius="17"
                        Foreground="{StaticResource AccentTextBrush}"
                        AutomationProperties.Name="Search"
                        ToolTipService.ToolTip="Search — opens the best match, or asks the AI">
                        <FontIcon FontSize="13" Glyph="&#xE721;" />
                    </Button>
                </Grid>
                </Grid>

                <!-- New chat: clears the conversation, returns to the empty state -->
                <Button
                    Grid.Column="1"
                    Width="52"
                    Height="52"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.NewConversationCommand}"
                    CornerRadius="26"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    AutomationProperties.Name="New chat"
                    ToolTipService.ToolTip="New chat">
                    <FontIcon FontSize="17" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <!-- ── Pending attachments — dropped files queued for the next question ── -->
            <ItemsControl
                Grid.Row="1"
                Margin="20,0,20,10"
                ItemsSource="{x:Bind ViewModel.PendingAttachments}"
                Visibility="{x:Bind conv:Vis.If(ViewModel.HasPendingAttachments), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingAttachment">
                        <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{x:Bind Path}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{StaticResource AccentTextBrush}"
                                    Glyph="{x:Bind controls:FileGlyphs.For(Name)}" />
                                <TextBlock
                                    MaxWidth="150"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Padding="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RemoveAttachment_Click"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="Remove attachment"
                                    ToolTipService.ToolTip="Remove attachment">
                                    <FontIcon
                                        FontSize="9"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Body: messages OR empty state ───────────────────── -->
            <Grid Grid.Row="2">

                <!-- Messages -->
                <ListView
                    x:Name="ResultsList"
                    Padding="16,4,16,10"
                    ItemsSource="{x:Bind ViewModel.Messages}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageViewModel">
                            <Grid Margin="0,4">
                                <!--  User message — right-aligned indigo glass capsule  -->
                                <Border
                                    MaxWidth="310"
                                    HorizontalAlignment="Right"
                                    Padding="14,9"
                                    Background="{StaticResource UserBubbleFillBrush}"
                                    BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16,16,5,16"
                                    Visibility="{x:Bind conv:Vis.If(IsUser)}">
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <!--  AI message — markdown prose with indigo accent bar  -->
                                <StackPanel HorizontalAlignment="Stretch" Spacing="4" Visibility="{x:Bind conv:Vis.IfNot(IsUser)}">
                                    <Grid>
                                        <Rectangle
                                            Width="3"
                                            Margin="0,4,0,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Fill="{StaticResource AccentBrush}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                        <controls:MessageContentControl Margin="14,0,0,0" Text="{x:Bind Text, Mode=OneWay}" />
                                    </Grid>

                                    <!--  Local files used as context — horizontally scrollable strip  -->
                                    <ScrollViewer
                                        Margin="14,2,0,0"
                                        HorizontalScrollBarVisibility="Hidden"
                                        HorizontalScrollMode="Enabled"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled"
                                        Visibility="{x:Bind conv:Vis.If(HasSources), Mode=OneWay}">
                                        <ItemsControl ItemsSource="{x:Bind Sources, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{Binding Path}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon
                                                                FontSize="12"
                                                                Foreground="{StaticResource AccentTextBrush}"
                                                                Glyph="&#xE7C3;" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state: recents + quick actions -->
                <StackPanel
                    x:Name="EmptyPanel"
                    Margin="16,8,16,0"
                    VerticalAlignment="Top"
                    Spacing="8">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <TextBlock
                        x:Name="RecentsLabel"
                        Margin="4,4,0,0"
                        FontSize="11"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="RECENT"
                        Visibility="Collapsed" />

                    <ItemsControl x:Name="RecentsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid PointerEntered="RecentRow_PointerEntered" PointerExited="RecentRow_PointerExited">
                                    <Button
                                        Click="Recent_Click"
                                        Style="{StaticResource OverlayActionButtonStyle}"
                                        Tag="{Binding Id}">
                                        <StackPanel Margin="0,0,24,0" Spacing="2">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="{Binding Meta}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RowDelete"
                                        Margin="0,0,8,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveRecent_Click"
                                        Opacity="0"
                                        Tag="{Binding Id}"
                                        AutomationProperties.Name="Remove from recents"
                                        ToolTipService.ToolTip="Remove from recents">
                                        <Button.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.12" />
                                        </Button.OpacityTransition>
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Recently launched search hits — replay with one click  -->
                    <TextBlock
                        x:Name="RecentItemsLabel"
                        Margin="4,10,0,0"
                        FontSize="11"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="RECENTLY OPENED"
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="RecentItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchRowViewModel">
                                <Grid PointerEntered="RecentRow_PointerEntered" PointerExited="RecentRow_PointerExited">
                                    <Button
                                        Click="RecentItem_Click"
                                        Style="{StaticResource OverlayActionButtonStyle}"
                                        Tag="{x:Bind}">
                                        <StackPanel Margin="0,0,24,0" Orientation="Horizontal" Spacing="10">
                                            <!--  Real shell icon once loaded; the glyph is the placeholder until then.  -->
                                            <Image
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind Icon, Mode=OneWay}"
                                                Visibility="{x:Bind conv:Vis.If(ShowImage), Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{StaticResource AccentTextBrush}"
                                                Glyph="{x:Bind Glyph}"
                                                Visibility="{x:Bind conv:Vis.If(ShowGlyph), Mode=OneWay}" />
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RowDelete"
                                        Margin="0,0,8,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveRecentItem_Click"
                                        Opacity="0"
                                        Tag="{x:Bind}"
                                        AutomationProperties.Name="Remove from recents"
                                        ToolTipService.ToolTip="Remove from recents">
                                        <Button.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.12" />
                                        </Button.OpacityTransition>
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Recent queries — one click re-runs the live search  -->
                    <TextBlock
                        x:Name="RecentQueriesLabel"
                        Margin="4,10,0,0"
                        FontSize="11"
                        CharacterSpacing="60"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="RECENT SEARCHES"
                        Visibility="Collapsed" />
                    <ItemsControl x:Name="RecentQueriesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid PointerEntered="RecentRow_PointerEntered" PointerExited="RecentRow_PointerExited">
                                    <Button
                                        Click="RecentQuery_Click"
                                        Style="{StaticResource OverlayActionButtonStyle}"
                                        Tag="{Binding}">
                                        <StackPanel Margin="0,0,24,0" Orientation="Horizontal" Spacing="10">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Glyph="&#xE721;" />
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RowDelete"
                                        Margin="0,0,8,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveRecentQuery_Click"
                                        Opacity="0"
                                        Tag="{Binding}"
                                        AutomationProperties.Name="Remove from recents"
                                        ToolTipService.ToolTip="Remove from recents">
                                        <Button.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.12" />
                                        </Button.OpacityTransition>
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Live launcher results — grouped, Windows-Search style. Selection is
                     keyboard-driven from the search box; focus never leaves the box. -->
                <ScrollViewer
                    x:Name="SearchPanel"
                    Padding="16,0,16,10"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ItemsControl x:Name="SearchRowsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchRowViewModel">
                                <Grid>
                                    <!--  Section header  -->
                                    <TextBlock
                                        Margin="4,14,0,6"
                                        FontSize="11"
                                        CharacterSpacing="60"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="{x:Bind Title}"
                                        Visibility="{x:Bind conv:Vis.If(IsHeader)}" />

                                    <!--  Launchable hit / Ask-AI row  -->
                                    <Grid
                                        MinHeight="44"
                                        Background="Transparent"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        Tapped="SearchRow_Tapped"
                                        Visibility="{x:Bind conv:Vis.If(IsSelectable)}">
                                        <Border
                                            Background="{StaticResource GlassHoverBrush}"
                                            BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Visibility="{x:Bind conv:Vis.If(IsSelected), Mode=OneWay}" />
                                        <StackPanel
                                            Margin="12,6"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                            <Image
                                                Width="22"
                                                Height="22"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind Icon, Mode=OneWay}"
                                                Visibility="{x:Bind conv:Vis.If(ShowImage), Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="15"
                                                Foreground="{StaticResource AccentTextBrush}"
                                                Glyph="{x:Bind Glyph}"
                                                Visibility="{x:Bind conv:Vis.If(ShowGlyph), Mode=OneWay}" />
                                            <controls:SparkleIcon
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind conv:Vis.If(IsAskAi)}" />
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock
                                                    MaxWidth="300"
                                                    FontSize="13"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    MaxWidth="300"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind conv:Vis.If(HasSubtitle)}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Footer ──────────────────────────────────────────── -->
            <Border
                Grid.Row="3"
                Padding="18,14"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Privacy / model badge — capsule geometry mirrors the search pill  -->
                    <Grid Grid.Column="0">
                        <Border
                            Height="44"
                            Background="{StaticResource GlassFillBrush}"
                            BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="22" />
                        <Border
                            Height="44"
                            Background="{StaticResource GlassSheenBrush}"
                            CornerRadius="22"
                            IsHitTestVisible="False" />
                        <StackPanel
                            Margin="16,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ModelLabel, Mode=OneWay}">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{StaticResource AccentBrush}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{StaticResource AccentBrush}"
                                Glyph="{x:Bind ViewModel.ModelGlyph, Mode=OneWay}"
                                Visibility="{x:Bind conv:Vis.IfNot(ViewModel.IsBusy), Mode=OneWay}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ModelShortLabel, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!--  Keyboard hint  -->
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TextGhostBrush}"
                        Text="Alt+Space · Esc" />

                    <!--  Open the full app — capsule geometry mirrors the search pill  -->
                    <Button
                        Grid.Column="2"
                        Height="44"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource GlassFillBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}"
                        BorderThickness="1"
                        Click="OpenApp_Click"
                        CornerRadius="22"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        ToolTipService.ToolTip="Open WindowsAI">
                        <StackPanel
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                            <TextBlock
                                x:Name="OpenAppLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="Open app" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>

        <!-- Inner depth shadow along the right edge — panel reads as floating glass -->
        <Rectangle
            Width="12"
            HorizontalAlignment="Right"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#46000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Accent edge: the panel's right border follows the OS accent color. It sits
             persistently at rest and gently pulses while the assistant is thinking
             (replaces the old running-light rainbow comet). -->
        <Border
            x:Name="AccentFrame"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="0,0,1.5,0"
            IsHitTestVisible="False"
            Opacity="0.6">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.3" />
            </Border.OpacityTransition>
        </Border>

        <!-- Drop affordance: revealed while Explorer files are dragged over the overlay -->
        <Border
            x:Name="DropAffordance"
            Margin="10"
            Background="{StaticResource AccentFillSubtleBrush}"
            BorderBrush="{StaticResource AccentStrokeBrush}"
            BorderThickness="2"
            CornerRadius="18"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{StaticResource AccentTextBrush}"
                    Glyph="&#xE8E5;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Drop files to attach" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
