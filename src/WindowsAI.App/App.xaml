<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindowsAI_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WindowsAI_App.Converters"
    xmlns:local="using:WindowsAI_App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters (shared across all pages; Window XAML uses conv:Vis function binds instead) -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvBoolToVisConverter" />

            <!--
                Brand typography — defined here (not in Palette.xaml) so BasedOn can resolve
                against XamlControlsResources, which is only in scope in this merged context.
            -->
            <Style
                x:Key="BrandDisplayStyle"
                BasedOn="{StaticResource TitleLargeTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>
            <Style
                x:Key="BrandTitleStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>
            <Style
                x:Key="BrandCaptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
