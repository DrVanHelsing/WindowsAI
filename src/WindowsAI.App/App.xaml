<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindowsAI_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WindowsAI_App.Converters"
    xmlns:local="using:WindowsAI_App"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters (shared across all pages; Window XAML uses conv:Vis function binds instead) -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:InvertedBoolToVisibilityConverter x:Key="InvBoolToVisConverter" />

            <!--
                Brand typography — defined here (not in Palette.xaml) so BasedOn can resolve
                against XamlControlsResources, which is only in scope in this merged context.
            -->
            <Style
                x:Key="BrandDisplayStyle"
                BasedOn="{StaticResource TitleLargeTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>
            <Style
                x:Key="BrandTitleStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>
            <Style
                x:Key="BrandCaptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <!--
                Liquid-glass building blocks. Property-setter styles only — ControlTemplates
                must stay in page/window resources (XamlCompiler silently fails otherwise).
            -->
            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
            </Style>

            <Style x:Key="GlassCardSubtleStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
            </Style>

            <Style x:Key="GlassChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <!--
                Composer pills — the active-model badge (a Border) and the "Search my PC"
                ToggleButton share one geometry (padding · pill radius · caption type) so they
                read as a matched set. The toggle's on-brand checked look (accent, mirroring the
                badge) comes from local ToggleButton* brush overrides on the instance, not a
                ControlTemplate — templates fail silently here (see project memory).
            -->
            <Style x:Key="ComposerPillStyle" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
                <Setter Property="Background" Value="{StaticResource AccentFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentStrokeBrush}" />
            </Style>

            <Style x:Key="ComposerTogglePillStyle" TargetType="ToggleButton">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
            </Style>

            <!--
                Source chip — a found local file shown under a reply (click to open). A squircle
                (RadiusLarge), not a full pill, so a grid of them reads as tiles rather than
                tablets. Shared by the shell and the overlay so the two stay in sync.
            -->
            <Style x:Key="SourceChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <!--  Page title — used by History / Models / Settings headers  -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TypeDisplaySize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <!--  Quiet circular icon button (hover fill comes from the default template)  -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
