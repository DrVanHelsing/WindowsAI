<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsAI_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Square glass tile holding a provider glyph, shared by every settings row.  -->
        <Style x:Key="SettingsIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource AccentFillSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>

        <!--  Section heading inside the content pane.  -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,24,28,16" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="Settings" />

        <!--  Category rail (left) + content pane (right)  -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Category rail  -->
            <ListView
                x:Name="SectionRail"
                Grid.Column="0"
                VerticalAlignment="Top"
                Background="Transparent"
                SelectionChanged="SectionRail_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE790;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Appearance" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE753;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Models &amp; providers" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Tools" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="About" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!--  Content pane  -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="640" HorizontalAlignment="Stretch">

                    <!--  ── APPEARANCE ──────────────────────────────────────────  -->
                    <StackPanel x:Name="AppearanceSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Appearance" />

                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="18">
                                <!--  Theme mode  -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Theme" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Match Windows, or pin a light or dark look." />
                                    <RadioButtons
                                        Margin="0,4,0,0"
                                        MaxColumns="3"
                                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <RadioButton Content="Windows default" />
                                        <RadioButton Content="Light" />
                                        <RadioButton Content="Dark" />
                                    </RadioButtons>
                                </StackPanel>

                                <!--  Accent color — swatches built in code-behind  -->
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Accent color" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Used across the overlay, buttons, and highlights." />
                                    <StackPanel
                                        x:Name="AccentSwatchPanel"
                                        Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── MODELS & PROVIDERS ──────────────────────────────────  -->
                    <StackPanel x:Name="ProvidersSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Models &amp; providers" />

                        <!--  Local model (Ollama) — endpoint edited via a modal  -->
                        <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Glyph="&#xE977;" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Local model (Ollama)" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Endpoint of your local Ollama server. Pull models with 'ollama pull'." />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{x:Bind ViewModel.OllamaEndpoint, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="ChangeEndpoint_Click"
                                    AutomationProperties.Name="Change Ollama endpoint"
                                    Content="Change…" />
                            </Grid>
                        </Border>

                        <!--  OpenRouter (cloud)  -->
                        <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Glyph="&#xE968;" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid
                                            Width="10"
                                            Height="10"
                                            VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource TextGhostBrush}" />
                                            <Ellipse Fill="{StaticResource AccentBrush}" Visibility="{x:Bind ViewModel.OpenRouterConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="OpenRouter (cloud)" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Get a key at openrouter.ai. Stored encrypted (DPAPI) on this PC only." />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="{x:Bind ViewModel.OpenRouterStatus, Mode=OneWay}" />

                                    <!--  Vision model for the screen-capture flow (Alt+Shift+S)  -->
                                    <Grid Margin="0,10,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="Vision model — for screen-capture questions (Alt+Shift+S)" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind ViewModel.VisionModelId, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ChangeVisionModel_Click"
                                            AutomationProperties.Name="Change vision model"
                                            Content="Change…" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="ManageOpenRouterKey_Click"
                                        AutomationProperties.Name="Manage OpenRouter API key"
                                        Content="Manage…"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="RemoveOpenRouterKey_Click"
                                        AutomationProperties.Name="Remove OpenRouter API key"
                                        Content="Remove"
                                        Visibility="{x:Bind ViewModel.OpenRouterConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Gemini (cloud)  -->
                        <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Glyph="&#xE753;" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid
                                            Width="10"
                                            Height="10"
                                            VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource TextGhostBrush}" />
                                            <Ellipse Fill="{StaticResource AccentBrush}" Visibility="{x:Bind ViewModel.GeminiConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gemini (cloud)" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Get a key from Google AI Studio. Stored encrypted (DPAPI) on this PC only." />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="{x:Bind ViewModel.GeminiStatus, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="ManageGeminiKey_Click"
                                        AutomationProperties.Name="Manage Gemini API key"
                                        Content="Manage…"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="RemoveGeminiKey_Click"
                                        AutomationProperties.Name="Remove Gemini API key"
                                        Content="Remove"
                                        Visibility="{x:Bind ViewModel.GeminiConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Gemini via Google sign-in (Vertex AI, OAuth)  -->
                        <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Glyph="&#xE77B;" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid
                                            Width="10"
                                            Height="10"
                                            VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource TextGhostBrush}" />
                                            <Ellipse Fill="{StaticResource AccentBrush}" Visibility="{x:Bind ViewModel.GoogleConnected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gemini via Google sign-in" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Use Gemini through Vertex AI with a Google sign-in instead of an API key. Create an OAuth &quot;Desktop app&quot; client in your Google Cloud project, then add its id, secret, and project below."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="{x:Bind ViewModel.GoogleStatus, Mode=OneWay}" />

                                    <!--  OAuth client id  -->
                                    <Grid Margin="0,10,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="OAuth client id" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind ViewModel.GoogleClientId, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ChangeGoogleClientId_Click"
                                            AutomationProperties.Name="Change OAuth client id"
                                            Content="Change…" />
                                    </Grid>

                                    <!--  Client secret  -->
                                    <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="Client secret — stored encrypted (DPAPI) on this PC only" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ManageGoogleClientSecret_Click"
                                            AutomationProperties.Name="Set Google client secret"
                                            Content="Set…" />
                                    </Grid>

                                    <!--  Project id  -->
                                    <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="Google Cloud project id (Vertex AI enabled)" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind ViewModel.GoogleProjectId, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ChangeGoogleProject_Click"
                                            AutomationProperties.Name="Change Google Cloud project id"
                                            Content="Change…" />
                                    </Grid>

                                    <!--  Region  -->
                                    <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="Vertex AI region" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind ViewModel.GoogleLocation, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ChangeGoogleLocation_Click"
                                            AutomationProperties.Name="Change Vertex AI region"
                                            Content="Change…" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="SignInWithGoogle_Click"
                                        AutomationProperties.Name="Sign in with Google"
                                        Content="Sign in…"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="SignOutOfGoogle_Click"
                                        Content="Sign out"
                                        Visibility="{x:Bind ViewModel.GoogleConnected, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  ── TOOLS ────────────────────────────────────────────────  -->
                    <StackPanel x:Name="ToolsSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Tools" />

                        <!--  Web search (Google Programmable Search)  -->
                        <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Glyph="&#xE721;" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid
                                            Width="10"
                                            Height="10"
                                            VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource TextGhostBrush}" />
                                            <Ellipse Fill="{StaticResource AccentBrush}" Visibility="{x:Bind ViewModel.WebSearchConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Web search" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Lets the assistant search the web (Google Programmable Search). Create a search engine at programmablesearchengine.google.com and an API key in your Google Cloud project."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="{x:Bind ViewModel.WebSearchStatus, Mode=OneWay}" />

                                    <!--  Search engine id (cx)  -->
                                    <Grid Margin="0,10,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Text="Search engine id (cx)" />
                                            <TextBlock
                                                FontFamily="{StaticResource MonoFontFamily}"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind ViewModel.WebSearchEngineId, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="ChangeWebSearchEngineId_Click"
                                            AutomationProperties.Name="Change search engine id"
                                            Content="Change…" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="ManageWebSearchKey_Click"
                                        AutomationProperties.Name="Manage web search API key"
                                        Content="Manage…"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Click="RemoveWebSearchKey_Click"
                                        AutomationProperties.Name="Remove web search API key"
                                        Content="Remove"
                                        Visibility="{x:Bind ViewModel.WebSearchConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  ── ABOUT ────────────────────────────────────────────────  -->
                    <StackPanel x:Name="AboutSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="About" />

                        <Border Padding="20,16" Style="{StaticResource GlassCardSubtleStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="15"
                                        Foreground="{StaticResource GlowGradientBrush}"
                                        Text="✦" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="WindowsAI" />
                                </StackPanel>
                                <Grid ColumnSpacing="24" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Version" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{x:Bind AppVersion}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Summon" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Alt + Space  ·  Writing tools: Ctrl + Shift + Space  ·  Ask about screen: Alt + Shift + S" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="Privacy" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Conversations and keys never leave this PC unless you use a cloud model."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
