<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsAI_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Square glass tile holding a provider glyph, shared by every settings row.  -->
        <Style x:Key="SettingsIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource AccentFillSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,24,28,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="Settings" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="640"
                HorizontalAlignment="Stretch"
                Spacing="10">

                <!--  Section label  -->
                <TextBlock
                    Margin="2,2,0,2"
                    FontSize="11"
                    CharacterSpacing="60"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="APPEARANCE" />

                <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="18">
                        <!--  Theme mode  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Theme" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Match Windows, or pin a light or dark look." />
                            <RadioButtons
                                Margin="0,4,0,0"
                                MaxColumns="3"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <RadioButton Content="Windows default" />
                                <RadioButton Content="Light" />
                                <RadioButton Content="Dark" />
                            </RadioButtons>
                        </StackPanel>

                        <!--  Accent color — swatches built in code-behind  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Accent color" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Used across the overlay, buttons, and highlights." />
                            <StackPanel
                                x:Name="AccentSwatchPanel"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Section label  -->
                <TextBlock
                    Margin="2,8,0,2"
                    FontSize="11"
                    CharacterSpacing="60"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="MODELS &amp; PROVIDERS" />

                <!--  Local model (Ollama) — endpoint edited via a modal  -->
                <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{StaticResource AccentTextBrush}"
                                Glyph="&#xE977;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Local model (Ollama)" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Endpoint of your local Ollama server. Pull models with 'ollama pull'." />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind ViewModel.OllamaEndpoint, Mode=OneWay}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="ChangeEndpoint_Click"
                            Content="Change…" />
                    </Grid>
                </Border>

                <!--  OpenRouter (cloud)  -->
                <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{StaticResource AccentTextBrush}"
                                Glyph="&#xE968;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="OpenRouter (cloud)" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Get a key at openrouter.ai. Stored encrypted (DPAPI) on this PC only." />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="{x:Bind ViewModel.OpenRouterStatus, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="ManageOpenRouterKey_Click"
                                Content="Manage…"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Click="RemoveOpenRouterKey_Click"
                                Content="Remove"
                                Visibility="{x:Bind ViewModel.OpenRouterConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Gemini (cloud)  -->
                <Border Padding="18,14" Style="{StaticResource GlassCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <FontIcon
                                FontSize="16"
                                Foreground="{StaticResource AccentTextBrush}"
                                Glyph="&#xE753;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Gemini (cloud)" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Get a key from Google AI Studio. Stored encrypted (DPAPI) on this PC only." />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="{x:Bind ViewModel.GeminiStatus, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="ManageGeminiKey_Click"
                                Content="Manage…"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Click="RemoveGeminiKey_Click"
                                Content="Remove"
                                Visibility="{x:Bind ViewModel.GeminiConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- About -->
                <Border
                    Margin="0,6,0,0"
                    Padding="20,16"
                    Style="{StaticResource GlassCardSubtleStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                FontSize="15"
                                Foreground="{StaticResource GlowGradientBrush}"
                                Text="✦" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="About" />
                        </StackPanel>
                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Version" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind AppVersion}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Summon" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Alt + Space  ·  Esc to dismiss" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Privacy" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Conversations and keys never leave this PC unless you use a cloud model."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
