<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsAI_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="Settings" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="640"
                HorizontalAlignment="Stretch"
                Spacing="14">

                <!-- Local model -->
                <Border Padding="20,16" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                FontSize="15"
                                Foreground="{StaticResource AccentTextBrush}"
                                Glyph="&#xE977;" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Local model (Ollama)" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Endpoint of your local Ollama server. Pull models with 'ollama pull'." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EndpointBox" Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Click="SaveEndpoint_Click"
                                Content="Save" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OpenRouter -->
                <Border Padding="20,16" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontSize="15"
                                    Foreground="{StaticResource AccentTextBrush}"
                                    Glyph="&#xE968;" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="OpenRouter (cloud)" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="{x:Bind ViewModel.OpenRouterStatus, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Get a key at openrouter.ai. Stored encrypted (DPAPI) on this PC only." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="OpenRouterKeyBox" PlaceholderText="sk-or-…" />
                            <Button
                                Grid.Column="1"
                                Click="SaveOpenRouterKey_Click"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Click="ClearOpenRouterKey_Click"
                                Content="Clear" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Gemini -->
                <Border Padding="20,16" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontSize="15"
                                    Foreground="{StaticResource AccentTextBrush}"
                                    Glyph="&#xE753;" />
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="Gemini (cloud)" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource AccentTextBrush}"
                                Text="{x:Bind ViewModel.GeminiStatus, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Get a key from Google AI Studio. Stored encrypted (DPAPI) on this PC only." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GeminiKeyBox" PlaceholderText="AIza…" />
                            <Button
                                Grid.Column="1"
                                Click="SaveGeminiKey_Click"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Click="ClearGeminiKey_Click"
                                Content="Clear" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Padding="20,16" Style="{StaticResource GlassCardSubtleStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                FontSize="15"
                                Foreground="{StaticResource GlowGradientBrush}"
                                Text="✦" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="About" />
                        </StackPanel>
                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Version" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind AppVersion}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Summon" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Alt + Space  ·  Esc to dismiss" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Privacy" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Conversations and keys never leave this PC unless you use a cloud model."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
