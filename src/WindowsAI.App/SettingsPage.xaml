<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsAI_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:providers="using:WindowsAI.Core.Providers"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource AccentFillSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="FieldHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CapabilityComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="28,24,28,16" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="Settings" />

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Category rail  -->
            <ListView
                x:Name="SectionRail"
                Grid.Column="0"
                VerticalAlignment="Top"
                Background="Transparent"
                SelectionChanged="SectionRail_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE790;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Appearance" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Chat" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE7B3;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Visual Intelligence" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Writing Tools" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Web Search" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xEB9F;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Image Generation" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="PC Indexing" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE72E;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="Privacy &amp; data" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="About" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!--  Content pane  -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="680" HorizontalAlignment="Stretch">

                    <!--  ── APPEARANCE ──  -->
                    <StackPanel x:Name="AppearanceSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Appearance" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Theme" />
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="Match Windows, or pin a light or dark look." />
                                    <RadioButtons
                                        Margin="0,4,0,0"
                                        MaxColumns="3"
                                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <RadioButton Content="Windows default" />
                                        <RadioButton Content="Light" />
                                        <RadioButton Content="Dark" />
                                    </RadioButtons>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Accent color" />
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="Used across the overlay, buttons, and highlights." />
                                    <StackPanel
                                        x:Name="AccentSwatchPanel"
                                        Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── CHAT ──  -->
                    <StackPanel x:Name="ChatSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Chat" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Default chat model" />
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="Used for everyday conversations. Add providers on the Models &amp; providers tab." />
                                <ComboBox
                                    Style="{StaticResource CapabilityComboStyle}"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.ChatModels}"
                                    PlaceholderText="Select a model"
                                    SelectedItem="{x:Bind ViewModel.ChatModel, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── VISUAL INTELLIGENCE ──  -->
                    <StackPanel x:Name="VisionSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Visual Intelligence" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Ask about your screen" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Capture a region and ask a vision-capable model about it." />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VisualIntelligenceEnabled, Mode=TwoWay}" />
                                </Grid>
                                <ComboBox
                                    Style="{StaticResource CapabilityComboStyle}"
                                    DisplayMemberPath="DisplayName"
                                    Header="Vision model"
                                    ItemsSource="{x:Bind ViewModel.VisionModels}"
                                    PlaceholderText="Auto (first vision-capable provider)"
                                    SelectedItem="{x:Bind ViewModel.VisionModel, Mode=TwoWay}" />
                                <Grid Margin="0,4,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Shortcut" />
                                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.VisionHotkeyText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChangeVisionHotkey_Click" Content="Change…" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── WRITING TOOLS ──  -->
                    <StackPanel x:Name="WritingSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Writing Tools" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Type-anywhere writing tools" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Proofread, rewrite, and change tone of selected text in any app." />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.WritingToolsEnabled, Mode=TwoWay}" />
                                </Grid>
                                <ComboBox
                                    Style="{StaticResource CapabilityComboStyle}"
                                    DisplayMemberPath="DisplayName"
                                    Header="Writing model"
                                    ItemsSource="{x:Bind ViewModel.WritingModels}"
                                    PlaceholderText="Use the chat model"
                                    SelectedItem="{x:Bind ViewModel.WritingModel, Mode=TwoWay}" />
                                <Grid Margin="0,4,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Shortcut" />
                                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.WritingHotkeyText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChangeWritingHotkey_Click" Content="Change…" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── WEB SEARCH ──  -->
                    <StackPanel x:Name="WebSearchSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Web Search" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Let the assistant search the web" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Backed by Tavily. Create a free key at tavily.com, then add it here." />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.WebSearchEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,4,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource AccentTextBrush}"
                                        Text="{x:Bind ViewModel.WebSearchStatus, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="ManageWebSearchKey_Click" Content="Manage…" Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Click="RemoveWebSearchKey_Click"
                                            Content="Remove"
                                            Visibility="{x:Bind ViewModel.WebSearchConfigured, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── IMAGE GENERATION ──  -->
                    <StackPanel x:Name="ImageSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Image Generation" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Generate images in chat" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Detected from your message and served by an image-capable provider." />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ImageGenerationEnabled, Mode=TwoWay}" />
                                </Grid>
                                <ComboBox
                                    Style="{StaticResource CapabilityComboStyle}"
                                    DisplayMemberPath="DisplayName"
                                    Header="Image model"
                                    ItemsSource="{x:Bind ViewModel.ImageModels}"
                                    PlaceholderText="Auto (first image-capable provider)"
                                    SelectedItem="{x:Bind ViewModel.ImageModel, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── PC INDEXING ──  -->
                    <StackPanel x:Name="PcIndexingSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="PC Indexing" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Search my PC" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="Let the assistant find your files using the Windows Search index." />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Pc.Enabled, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel Spacing="4">
                                    <ProgressBar Maximum="100" Value="{x:Bind Pc.ProgressPercent, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{x:Bind Pc.StatusText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Indexed folders" />
                                    <ItemsControl ItemsSource="{x:Bind Pc.Folders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid Margin="0,3" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource MonoFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{x:Bind}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Click="RemoveFolder_Click"
                                                        Content="Remove"
                                                        Tag="{x:Bind}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="AddFolder_Click" Content="Add folder…" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Click="RefreshIndex_Click" Content="Refresh status" />
                                    <Button Click="OpenIndexingOptions_Click" Content="Windows options…" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── PRIVACY & DATA ──  -->
                    <StackPanel x:Name="PrivacySection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Privacy &amp; data" />
                        <Border Padding="18,16" Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="Conversations and keys stay on this PC. Cloud providers only receive what you send them." />
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Data location" />
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="%LOCALAPPDATA%\WindowsAI" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenDataFolder_Click" Content="Open data folder" />
                                    <Button Click="OpenCrashLog_Click" Content="Open crash log" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ── ABOUT ──  -->
                    <StackPanel x:Name="AboutSection" Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="About" />
                        <Border Padding="20,16" Style="{StaticResource GlassCardSubtleStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontSize="15" Foreground="{StaticResource GlowGradientBrush}" Text="✦" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="WindowsAI" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Text="{x:Bind AppVersion}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Shortcuts" />
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="Summon search" />
                                            <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.SummonHotkeyText, Mode=OneWay}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Click="ChangeSummonHotkey_Click" Content="Change…" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="Visual Intelligence and Writing Tools shortcuts are on their own pages." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
