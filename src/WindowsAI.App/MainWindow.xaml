<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WindowsAI">
    <!-- Backdrop: liquid-glass acrylic applied in code-behind (GlassBackdrop.Apply). -->

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!--
                Sidebar navigation radio button — ghost flat item, no indicator circle.
                Defined here (Window body) not in App.xaml to avoid the standalone-compile
                ControlTemplate issue. String color values for DiscreteObjectKeyFrame avoid
                nested element syntax which the WinUI XAML compiler rejects in shared dicts.
            -->
            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <!--
                            Fluid nav item: stacked fill layers cross-fade via opacity
                            animations (smooth, GPU-friendly) and the checked state grows
                            a left accent indicator. Inline colors — StaticResource is
                            unreliable inside ControlTemplates in this compile scope.
                        -->
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverFill"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverFill"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.06" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="PressedFill"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="CheckedFill"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="IndicatorScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentArea" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border
                                    x:Name="HoverFill"
                                    Background="{StaticResource GlassHoverBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="PressedFill"
                                    Background="{StaticResource GlassPressedBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="CheckedFill"
                                    Background="{StaticResource AccentFillSubtleBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />

                                <Rectangle
                                    x:Name="Indicator"
                                    Width="3"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource AccentTextBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="IndicatorScale" ScaleY="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <ContentPresenter
                                    x:Name="ContentArea"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════ TITLE BAR — full-width drag strip (SetTitleBar in code-behind).
             Brand stays top-left; the whole strip (minus the caption buttons) drags
             the window, so it's grabbable across its full width. ═══════ -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,0,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="16"
                    Foreground="{StaticResource AccentTextBrush}"
                    Text="✦"
                    VerticalAlignment="Center" />
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="WindowsAI"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Title-bar bottom hairline -->
        <Rectangle
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Fill="{StaticResource HairlineBrush}" />

        <!-- ═══════ BODY — sidebar + content ═══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ SIDEBAR — translucent layer over the glass ════ -->
            <Grid x:Name="Sidebar" Grid.Column="0" Background="{StaticResource SidebarFillBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left brand-glow accent line -->
                <Rectangle
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Width="2"
                    HorizontalAlignment="Left"
                    Fill="{StaticResource GlowGradientBrush}"
                    Opacity="0.55" />

                <!-- New Chat button -->
                <Button
                    x:Name="NewChatButton"
                    Grid.Row="0"
                    Margin="12,12,12,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="{StaticResource GlassFillBrush}"
                    BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Padding="12,10"
                    Click="NewChatButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                        <TextBlock FontSize="13" Text="New chat" />
                    </StackPanel>
                </Button>

                <!-- Navigation items -->
                <StackPanel Grid.Row="1" Margin="12,4,12,4" Spacing="2">

                    <!-- IsChecked is set in code-behind: assigning it here fires Checked
                         mid-parse, before ContentFrame is connected, and crashes the window. -->
                    <RadioButton
                        x:Name="NavChat"
                        GroupName="AppNav"
                        Style="{StaticResource NavRadioButtonStyle}"
                        Tag="chat"
                        Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                            <TextBlock FontSize="13" Text="Chat" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        GroupName="AppNav"
                        Style="{StaticResource NavRadioButtonStyle}"
                        Tag="history"
                        Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE81C;" />
                            <TextBlock FontSize="13" Text="History" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        GroupName="AppNav"
                        Style="{StaticResource NavRadioButtonStyle}"
                        Tag="models"
                        Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE99A;" />
                            <TextBlock FontSize="13" Text="Models" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton
                        GroupName="AppNav"
                        Style="{StaticResource NavRadioButtonStyle}"
                        Tag="settings"
                        Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock FontSize="13" Text="Settings" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <!-- Version label -->
                <TextBlock
                    Grid.Row="2"
                    Margin="18,0,18,16"
                    VerticalAlignment="Bottom"
                    FontSize="11"
                    Foreground="{StaticResource TextGhostBrush}"
                    Text="WindowsAI · Preview" />

            </Grid>

            <!-- Sidebar / content divider -->
            <Rectangle
                Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                Fill="{StaticResource HairlineBrush}" />

            <!-- ═══════════════ CONTENT FRAME ══════════════════════════════════ -->
            <Frame x:Name="ContentFrame" Grid.Column="1" />

        </Grid>

    </Grid>
</Window>
