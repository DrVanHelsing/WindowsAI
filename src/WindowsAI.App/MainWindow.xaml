<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsAI_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WindowsAI">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--
                Sidebar navigation radio button — ghost flat item, no indicator circle.
                Defined here (Window body) not in App.xaml to avoid the standalone-compile
                ControlTemplate issue. String color values for DiscreteObjectKeyFrame avoid
                nested element syntax which the WinUI XAML compiler rejects in shared dicts.
            -->
            <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#AAFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#0AFFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#18FFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#207A6CFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentArea" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="ContentArea"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR ═══════════════════════════════════════ -->
        <Grid x:Name="Sidebar" Grid.Column="0" Background="#0A0A12">

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left brand-glow accent line -->
            <Rectangle
                Grid.Row="0"
                Grid.RowSpan="4"
                Width="2"
                HorizontalAlignment="Left"
                Fill="{StaticResource GlowGradientBrush}"
                Opacity="0.55" />

            <!-- Brand bar — registered as title-bar drag region in code-behind -->
            <Grid
                x:Name="BrandBar"
                Grid.Row="0"
                Padding="18,0,16,0">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        Foreground="#7A6CFF"
                        Text="✦"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="WindowsAI"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Brand bar bottom border -->
            <Rectangle
                Grid.Row="0"
                Height="1"
                Margin="16,0"
                VerticalAlignment="Bottom"
                Fill="#10FFFFFF" />

            <!-- New Chat button -->
            <Button
                x:Name="NewChatButton"
                Grid.Row="1"
                Margin="12,12,12,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="#12FFFFFF"
                BorderThickness="0"
                CornerRadius="8"
                Foreground="White"
                Padding="12,10"
                Click="NewChatButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                    <TextBlock FontSize="13" Text="New chat" />
                </StackPanel>
            </Button>

            <!-- Navigation items -->
            <StackPanel Grid.Row="2" Margin="12,4,12,4" Spacing="2">

                <RadioButton
                    x:Name="NavChat"
                    GroupName="AppNav"
                    IsChecked="True"
                    Style="{StaticResource NavRadioButtonStyle}"
                    Tag="chat"
                    Checked="NavItem_Checked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="14" Glyph="&#xE8BD;" />
                        <TextBlock FontSize="13" Text="Chat" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="AppNav"
                    Style="{StaticResource NavRadioButtonStyle}"
                    Tag="history"
                    Checked="NavItem_Checked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="14" Glyph="&#xE81C;" />
                        <TextBlock FontSize="13" Text="History" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="AppNav"
                    Style="{StaticResource NavRadioButtonStyle}"
                    Tag="models"
                    Checked="NavItem_Checked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="14" Glyph="&#xE99A;" />
                        <TextBlock FontSize="13" Text="Models" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="AppNav"
                    Style="{StaticResource NavRadioButtonStyle}"
                    Tag="settings"
                    Checked="NavItem_Checked">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock FontSize="13" Text="Settings" />
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <!-- Version label -->
            <TextBlock
                Grid.Row="3"
                Margin="18,0,18,16"
                VerticalAlignment="Bottom"
                FontSize="11"
                Foreground="#33FFFFFF"
                Text="WindowsAI · Preview" />

        </Grid>

        <!-- Sidebar / content divider -->
        <Rectangle
            Grid.Column="0"
            Width="1"
            HorizontalAlignment="Right"
            Fill="#08FFFFFF" />

        <!-- ═══════════════ CONTENT FRAME ══════════════════════════════════ -->
        <Frame x:Name="ContentFrame" Grid.Column="1" />

    </Grid>
</Window>
