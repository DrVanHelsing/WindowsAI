<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Accent now follows Windows: no SystemAccentColor* overrides here, so built-in WinUI controls
        derive their accent brushes from the OS accent. The app's own accent-family tokens live in
        Tokens.xaml and are re-derived from the OS accent live by ThemeSyncService.

        NOTE: keep this dictionary to colors + brushes only. The XAML toolchain compiles it
        standalone, and a <Style> here (even self-contained) crashes the compiler. The brand
        typography styles therefore live in App.xaml, which has the full merged scope.
    -->

</ResourceDictionary>
