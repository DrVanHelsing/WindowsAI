<?xml version="1.0" encoding="utf-8" ?>
<!--
    Design tokens v2 — the single source of truth for the app's visual language.
    Liquid glass: Fluent materials + Apple translucency layering.

    RULES (build breaks silently if violated — see project memory):
      • Primitives ONLY in this file: Color, Brush, Double, CornerRadius, Thickness, String.
      • No <Style>, no BasedOn, no ControlTemplate — those live in App.xaml or page resources.

    SCALES:
      • Radius:  6 / 10 / 14 / 20 / 28 (pill)   — nest concentrically: outer = inner + gap.
      • Spacing: 4 / 8 / 12 / 16 / 20 / 24 / 32 — used directly as Padding/Margin values.
      • Type:    28 display · 20 title · 15 body · 13 small · 11 caption · 13 mono.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════ Radius scale ════════ -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">28</CornerRadius>

    <!-- Legacy keys (kept for existing references) -->
    <x:Double x:Key="OverlayCornerRadiusValue">20</x:Double>
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="OverlayInnerCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <!-- ════════ Motion ════════ -->
    <x:String x:Key="MotionFast">0:0:0.15</x:String>
    <x:String x:Key="MotionMedium">0:0:0.25</x:String>
    <x:String x:Key="MotionSlow">0:0:0.4</x:String>
    <x:String x:Key="MotionGlowCycle">0:0:8</x:String>

    <!-- ════════ Text hierarchy ════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AFFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="TextGhostBrush" Color="#33FFFFFF" />

    <!-- ════════ Brand accent ════════ -->
    <Color x:Key="AccentColor">#7A6CFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#7A6CFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A99BFF" />
    <SolidColorBrush x:Key="AccentFillSubtleBrush" Color="#1F7A6CFF" />
    <SolidColorBrush x:Key="AccentFillMediumBrush" Color="#387A6CFF" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#4D7A6CFF" />

    <!--  Signature glow gradient — the app's visual identity  -->
    <LinearGradientBrush x:Key="GlowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#4F8CFF" />
        <GradientStop Offset="0.30" Color="#9B6BFF" />
        <GradientStop Offset="0.55" Color="#FF6BD6" />
        <GradientStop Offset="0.80" Color="#FF9D5C" />
        <GradientStop Offset="1.0" Color="#4DE3FF" />
    </LinearGradientBrush>

    <!--  Soft accent used for the overlay's outer aura shadow  -->
    <Color x:Key="GlowAuraColor">#7A5CFF</Color>

    <!-- ════════ Liquid glass surfaces ════════
         Three elevation levels of translucent fill + edge-lit strokes + sheen.
         Layer rule (Apple): the deeper the layer, the more transparent. -->
    <SolidColorBrush x:Key="GlassFillSubtleBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassFillElevatedBrush" Color="#1FFFFFFF" />

    <!--  Hover / pressed feedback fills for glass surfaces  -->
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="GlassPressedBrush" Color="#29FFFFFF" />

    <!--  Edge-lit stroke: bright top rim, faint sides, soft bottom reflection  -->
    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#55FFFFFF" />
        <GradientStop Offset="0.45" Color="#12FFFFFF" />
        <GradientStop Offset="1.0" Color="#26FFFFFF" />
    </LinearGradientBrush>

    <!--  Quieter stroke for subtle chips / secondary cards  -->
    <LinearGradientBrush x:Key="GlassStrokeSubtleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#30FFFFFF" />
        <GradientStop Offset="0.5" Color="#0CFFFFFF" />
        <GradientStop Offset="1.0" Color="#16FFFFFF" />
    </LinearGradientBrush>

    <!--  Specular sheen laid over a whole surface (top-down light falloff)  -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#14FFFFFF" />
        <GradientStop Offset="0.22" Color="#05FFFFFF" />
        <GradientStop Offset="1.0" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!-- ════════ Chat surfaces ════════ -->
    <!--  User bubble: translucent indigo glass  -->
    <SolidColorBrush x:Key="UserBubbleFillBrush" Color="#B32A2470" />
    <!--  Code block: darker glass well so monospace text pops  -->
    <SolidColorBrush x:Key="CodeFillBrush" Color="#66000000" />
    <SolidColorBrush x:Key="CodeHeaderFillBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="InlineCodeFillBrush" Color="#2E7A6CFF" />

    <!--  Divider hairline  -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#0FFFFFFF" />

    <!--  Modal dialog surface — near-opaque dark indigo so content reads over the dimmed backdrop  -->
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F21A1626" />

    <!-- ════════ Type ════════ -->
    <x:String x:Key="MonoFontFamily">Cascadia Code,Cascadia Mono,Consolas</x:String>
    <x:Double x:Key="TypeDisplaySize">28</x:Double>
    <x:Double x:Key="TypeTitleSize">20</x:Double>
    <x:Double x:Key="TypeBodySize">15</x:Double>
    <x:Double x:Key="TypeSmallSize">13</x:Double>
    <x:Double x:Key="TypeCaptionSize">11</x:Double>
    <x:Double x:Key="TypeMonoSize">13</x:Double>

</ResourceDictionary>
