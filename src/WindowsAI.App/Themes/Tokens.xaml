<?xml version="1.0" encoding="utf-8" ?>
<!--
    Design tokens v3 — "Electric Iris" — the single source of truth for the app's visual language.
    Liquid glass: Fluent materials + Apple translucency layering, centred on an electric-iris accent.

    RULES (build breaks silently if violated — see project memory):
      • Primitives ONLY in this file: Color, Brush, Double, CornerRadius, Thickness, String.
      • No <Style>, no BasedOn, no ControlTemplate, no <FontFamily> object — those crash the
        standalone XAML compiler here. Font families are stored as x:String and converted on use.

    SCALES:
      • Radius:  6 / 10 / 14 / 20 / 28 (pill)   — nest concentrically: outer = inner + gap.
      • Spacing: 4 / 8 / 12 / 16 / 20 / 24 / 32 — used directly as Padding/Margin values.
      • Type:    30 display · 20 title · 15 body · 13 small · 11 caption · 13 mono  (Inter Variable).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════ Radius scale ════════ -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">28</CornerRadius>

    <!-- Legacy keys (kept for existing references) -->
    <x:Double x:Key="OverlayCornerRadiusValue">20</x:Double>
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="OverlayInnerCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <!-- ════════ Motion ════════
         Durations + the signature expressive easing (expo-out, cubic-bezier(0.16,1,0.3,1)),
         stored as a KeySpline string for use in storyboards' EasingFunction key splines. -->
    <x:String x:Key="MotionFast">0:0:0.15</x:String>
    <x:String x:Key="MotionMedium">0:0:0.25</x:String>
    <x:String x:Key="MotionSlow">0:0:0.4</x:String>
    <x:String x:Key="MotionExpressiveSpline">0.16,1 0.3,1</x:String>

    <!-- ════════ Type ════════
         Inter Variable is the app's UI face; the weight axis covers 300–700 from one file.
         Stored as strings (FontFamily converts on use) so this dictionary stays primitives-only. -->
    <x:String x:Key="AppFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</x:String>
    <x:String x:Key="MonoFontFamily">Cascadia Code,Cascadia Mono,Consolas</x:String>
    <x:Double x:Key="TypeDisplaySize">30</x:Double>
    <x:Double x:Key="TypeTitleSize">20</x:Double>
    <x:Double x:Key="TypeBodySize">15</x:Double>
    <x:Double x:Key="TypeSmallSize">13</x:Double>
    <x:Double x:Key="TypeCaptionSize">11</x:Double>
    <x:Double x:Key="TypeMonoSize">13</x:Double>

    <!-- ════════ Text hierarchy ════════
         White at descending opacity — tuned for AA legibility on the dark glass base. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6EFFFFFF" />
    <SolidColorBrush x:Key="TextGhostBrush" Color="#38FFFFFF" />

    <!-- ════════ Brand accent — Electric Iris ════════ -->
    <Color x:Key="AccentColor">#6E7BFF</Color>
    <Color x:Key="AccentGlowColor">#6E7BFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#6E7BFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A8AEFF" />
    <SolidColorBrush x:Key="AccentFillSubtleBrush" Color="#1F6E7BFF" />
    <SolidColorBrush x:Key="AccentFillMediumBrush" Color="#386E7BFF" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#4D6E7BFF" />

    <!--  Signature glow gradient — the app's visual identity, re-tuned cooler around iris  -->
    <LinearGradientBrush x:Key="GlowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#4F8CFF" />
        <GradientStop Offset="0.33" Color="#6E7BFF" />
        <GradientStop Offset="0.66" Color="#B06BFF" />
        <GradientStop Offset="1.0" Color="#4DE3FF" />
    </LinearGradientBrush>

    <!-- ════════ Liquid glass surfaces ════════
         Three elevation levels of translucent fill + edge-lit strokes + sheen.
         Layer rule (Apple): the deeper the layer, the more transparent. -->
    <SolidColorBrush x:Key="GlassFillSubtleBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassFillElevatedBrush" Color="#1FFFFFFF" />

    <!--  Accent-tinted glass — for primary/active surfaces that should read as "live"  -->
    <SolidColorBrush x:Key="GlassFillAccentBrush" Color="#1A6E7BFF" />

    <!--  Hover / pressed feedback fills for glass surfaces  -->
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="GlassPressedBrush" Color="#29FFFFFF" />

    <!--  Edge-lit stroke: bright top rim, faint sides, soft bottom reflection  -->
    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#5CFFFFFF" />
        <GradientStop Offset="0.45" Color="#12FFFFFF" />
        <GradientStop Offset="1.0" Color="#26FFFFFF" />
    </LinearGradientBrush>

    <!--  Quieter stroke for subtle chips / secondary cards  -->
    <LinearGradientBrush x:Key="GlassStrokeSubtleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#33FFFFFF" />
        <GradientStop Offset="0.5" Color="#0CFFFFFF" />
        <GradientStop Offset="1.0" Color="#16FFFFFF" />
    </LinearGradientBrush>

    <!--  Accent-lit stroke — edge glow for primary/active glass surfaces  -->
    <LinearGradientBrush x:Key="GlassStrokeAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#807B86FF" />
        <GradientStop Offset="0.5" Color="#386E7BFF" />
        <GradientStop Offset="1.0" Color="#4D6E7BFF" />
    </LinearGradientBrush>

    <!--  Specular sheen laid over a whole surface (top-down light falloff)  -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#14FFFFFF" />
        <GradientStop Offset="0.22" Color="#05FFFFFF" />
        <GradientStop Offset="1.0" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!-- ════════ Chat surfaces ════════ -->
    <!--  User bubble: translucent iris glass  -->
    <SolidColorBrush x:Key="UserBubbleFillBrush" Color="#B32E2A78" />
    <!--  Code block: darker glass well so monospace text pops  -->
    <SolidColorBrush x:Key="CodeFillBrush" Color="#66000000" />
    <SolidColorBrush x:Key="CodeHeaderFillBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="InlineCodeFillBrush" Color="#2E6E7BFF" />

    <!--  Divider hairline  -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#12FFFFFF" />

    <!--  Modal dialog surface — near-opaque dark indigo so content reads over the dimmed backdrop  -->
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F21A1626" />

    <!--  Overlay readability scrim (over the transparent backdrop) + main-window sidebar veil.
          Both flip light/dark live via ThemeSyncService, which mutates these shared instances.  -->
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B30D0A1C" />
    <SolidColorBrush x:Key="SidebarFillBrush" Color="#590A0816" />

</ResourceDictionary>
