<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--  Composer ambient bar pulse during inference  -->
        <Storyboard
            x:Name="ComposerPulseStoryboard"
            AutoReverse="True"
            RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="ComposerAmbientBar"
                Storyboard.TargetProperty="Opacity"
                From="0.30"
                To="1.0"
                Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--
            Rainbow-gradient circle send button.
            Defined here (not App.xaml) to keep ControlTemplate in compiled-page scope.
            Inline gradient avoids StaticResource resolution inside a ControlTemplate.
        -->
        <Style x:Key="GradientCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.07"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.07"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="0.93"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.93"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.38" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!--  Gradient fill ellipse  -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#4F8CFF" />
                                        <GradientStop Offset="0.30" Color="#9B6BFF" />
                                        <GradientStop Offset="0.55" Color="#FF6BD6" />
                                        <GradientStop Offset="0.80" Color="#FF9D5C" />
                                        <GradientStop Offset="1.0" Color="#4DE3FF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Conversation ──────────────────────────────────────────── -->
        <ScrollViewer
            x:Name="ConvoScroll"
            Grid.Row="0"
            Padding="0,16,0,8"
            VerticalScrollBarVisibility="Hidden">
            <ListView
                x:Name="ChatList"
                Padding="32,0,32,16"
                MaxWidth="740"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Messages}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                        <Grid Margin="0,4">

                            <!--  User bubble — right-aligned deep indigo capsule  -->
                            <Border
                                MaxWidth="560"
                                HorizontalAlignment="Right"
                                Padding="16,12"
                                Background="#221E5C"
                                CornerRadius="20,20,4,20"
                                Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="White"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="24"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  AI message — open prose with left accent bar  -->
                            <Grid
                                MaxWidth="700"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind IsUser, Converter={StaticResource InvBoolToVisConverter}}">
                                <Rectangle
                                    Width="3"
                                    Margin="0,4,0,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Fill="#7A6CFF"
                                    RadiusX="2"
                                    RadiusY="2" />
                                <TextBlock
                                    Margin="16,0,0,0"
                                    FontSize="15"
                                    Foreground="#EEFFFFFF"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="26"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- ── Composer card ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!--  Gradient ambient bar above the composer  -->
            <Rectangle
                x:Name="ComposerAmbientBar"
                Height="1"
                VerticalAlignment="Top"
                Fill="{StaticResource GlowGradientBrush}"
                Opacity="0.30" />

            <Border
                Margin="0,1,0,0"
                Padding="24,16"
                Background="#0C0C16">
                <Grid MaxWidth="740" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Input  -->
                    <TextBox
                        x:Name="InputBox"
                        Grid.Row="0"
                        MinHeight="52"
                        MaxHeight="140"
                        Padding="14,13"
                        AcceptsReturn="True"
                        Background="#10FFFFFF"
                        BorderBrush="#157A6CFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        FontSize="15"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        KeyDown="InputBox_KeyDown"
                        PlaceholderText="Ask WindowsAI…  (Enter to send, Shift+Enter for newline)"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <!--  Toolbar row  -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Model + context chips  -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">

                            <!--  Active model pill  -->
                            <Border
                                Padding="10,5"
                                Background="#157A6CFF"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="#9B80FF"
                                        Glyph="&#xE72E;" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#9B80FF"
                                        Text="{x:Bind ViewModel.ModelLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!--  Context chips  -->
                            <Border
                                Padding="10,5"
                                Background="#0DFFFFFF"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontSize="10" Foreground="#66FFFFFF" Glyph="&#xE7F4;" />
                                    <TextBlock FontSize="11" Foreground="#66FFFFFF" Text="Screen" />
                                </StackPanel>
                            </Border>
                            <Border
                                Padding="10,5"
                                Background="#0DFFFFFF"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon FontSize="10" Foreground="#66FFFFFF" Glyph="&#xE77F;" />
                                    <TextBlock FontSize="11" Foreground="#66FFFFFF" Text="Clipboard" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!--  Gradient send / busy indicator  -->
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.SendCommand}"
                            Style="{StaticResource GradientCircleButtonStyle}"
                            ToolTipService.ToolTip="Send (Enter)">
                            <Grid>
                                <FontIcon
                                    FontSize="16"
                                    Foreground="White"
                                    Glyph="&#xE724;"
                                    Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    Foreground="White"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>
                        </Button>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
