<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowsAI_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WindowsAI_App.ViewModels"
    xmlns:controls="using:WindowsAI_App.Controls"
    xmlns:ctx="using:WindowsAI.Core.Context"
    xmlns:tools="using:WindowsAI.Core.Tools"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--  Composer ambient bar pulse during inference  -->
        <Storyboard
            x:Name="ComposerPulseStoryboard"
            AutoReverse="True"
            RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="ComposerAmbientBar"
                Storyboard.TargetProperty="Opacity"
                From="0.30"
                To="1.0"
                Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!--  Empty-state suggestion chip  -->
        <Style x:Key="SuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassFillSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!--
            Rainbow-gradient circle send button.
            Defined here (not App.xaml) to keep ControlTemplate in compiled-page scope.
            Inline gradient avoids StaticResource resolution inside a ControlTemplate.
        -->
        <Style x:Key="GradientCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.08"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.08"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="0.92"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="0.92"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0" Value="0.38" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!--  Gradient fill ellipse  -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0.0" Color="#4F8CFF" />
                                        <GradientStop Offset="0.30" Color="#9B6BFF" />
                                        <GradientStop Offset="0.55" Color="#FF6BD6" />
                                        <GradientStop Offset="0.80" Color="#FF9D5C" />
                                        <GradientStop Offset="1.0" Color="#4DE3FF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="Page_DragOver"
        DragLeave="Page_DragLeave"
        Drop="Page_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Conversation ──────────────────────────────────────────── -->
        <ListView
            x:Name="ChatList"
            Grid.Row="0"
            MaxWidth="800"
            Padding="32,20,32,12"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Messages}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionMode="None">
            <ListView.Resources>
                <!--  Chat rows are not interactive list items — kill hover/press tints  -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid
                        Margin="0,4"
                        PointerEntered="Message_PointerEntered"
                        PointerExited="Message_PointerExited">

                        <!--  User bubble — right-aligned indigo glass capsule (+ attachment chips)  -->
                        <StackPanel
                            MaxWidth="560"
                            HorizontalAlignment="Right"
                            Spacing="6"
                            Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisConverter}}">
                            <Border
                                HorizontalAlignment="Right"
                                Padding="16,11"
                                Background="{StaticResource UserBubbleFillBrush}"
                                BorderBrush="{StaticResource GlassStrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="18,18,6,18">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="24"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  Files the user sent with this message — click a chip to open  -->
                            <GridView
                                HorizontalAlignment="Right"
                                IsItemClickEnabled="True"
                                ItemClick="Source_Click"
                                ItemsSource="{x:Bind Sources, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None"
                                Visibility="{x:Bind HasSources, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <GridView.Resources>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                </GridView.Resources>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="8,0,0,8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="ctx:LocalDocument">
                                        <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{x:Bind Path}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    FontSize="15"
                                                    Foreground="{StaticResource AccentTextBrush}"
                                                    Glyph="{x:Bind controls:FileGlyphs.For(Name)}" />
                                                <TextBlock
                                                    MaxWidth="220"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <!--  AI message — markdown-rendered prose with accent bar + hover actions  -->
                        <StackPanel
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            Spacing="4"
                            Visibility="{x:Bind IsUser, Converter={StaticResource InvBoolToVisConverter}}">

                            <!--  Surfaced agent steps (tool calls) — glyph + summary, web results as link chips  -->
                            <ItemsControl
                                Margin="16,2,0,2"
                                ItemsSource="{x:Bind Activities}"
                                Visibility="{x:Bind HasActivities, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolActivityViewModel">
                                        <StackPanel Margin="0,0,0,4" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource AccentTextBrush}"
                                                    Glyph="{x:Bind Glyph}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Text="{x:Bind Summary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--  Web result links — click a chip to open in the browser  -->
                                            <GridView
                                                IsItemClickEnabled="True"
                                                ItemClick="Activity_LinkClick"
                                                ItemsSource="{x:Bind Links}"
                                                ScrollViewer.HorizontalScrollMode="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollMode="Disabled"
                                                SelectionMode="None"
                                                Visibility="{x:Bind HasLinks, Converter={StaticResource BoolToVisConverter}}">
                                                <GridView.Resources>
                                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                                </GridView.Resources>
                                                <GridView.ItemContainerStyle>
                                                    <Style TargetType="GridViewItem">
                                                        <Setter Property="Margin" Value="0,0,8,8" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinWidth" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    </Style>
                                                </GridView.ItemContainerStyle>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="tools:WebResult">
                                                        <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{x:Bind Url}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource AccentTextBrush}"
                                                                    Glyph="&#xE71B;" />
                                                                <TextBlock
                                                                    MaxWidth="240"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Text="{x:Bind Title}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Rectangle
                                    Width="3"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Fill="{StaticResource AccentBrush}"
                                    RadiusX="2"
                                    RadiusY="2" />
                                <controls:MessageContentControl Margin="16,0,0,0" Text="{x:Bind Text, Mode=OneWay}" />
                            </Grid>

                            <!--  Local files used as context — click a tile to open the file  -->
                            <GridView
                                Margin="14,4,0,0"
                                IsItemClickEnabled="True"
                                ItemClick="Source_Click"
                                ItemsSource="{x:Bind Sources, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None"
                                Visibility="{x:Bind HasSources, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <GridView.Resources>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                </GridView.Resources>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="ctx:LocalDocument">
                                        <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{x:Bind Path}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    FontSize="15"
                                                    Foreground="{StaticResource AccentTextBrush}"
                                                    Glyph="{x:Bind controls:FileGlyphs.For(Name)}" />
                                                <TextBlock
                                                    MaxWidth="220"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <!--  Hover-revealed actions  -->
                            <StackPanel
                                x:Name="ActionsRow"
                                Margin="16,0,0,0"
                                Opacity="0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <StackPanel.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </StackPanel.OpacityTransition>
                                <Button
                                    Click="CopyMessage_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Copy message">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                        <TextBlock FontSize="11" Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="RetryMessage_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Regenerate the latest reply">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                        <TextBlock FontSize="11" Text="Retry" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource TextGhostBrush}"
                                    Text="{x:Bind TimeLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ── Empty state — greeting + suggestions ─────────────────── -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="0"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="34"
                Foreground="{StaticResource GlowGradientBrush}"
                Text="✦" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="SemiBold"
                CharacterSpacing="-20"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="How can I help?" />
            <TextBlock
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="Private by default — conversations stay on this PC." />

            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Click="Suggestion_Click"
                    Style="{StaticResource SuggestionButtonStyle}"
                    Tag="Write a Python script that renames every file in a folder">
                    <TextBlock Text="🐍  Write a Python script" TextWrapping="Wrap" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Click="Suggestion_Click"
                    Style="{StaticResource SuggestionButtonStyle}"
                    Tag="Draft a short, professional email asking to reschedule a meeting">
                    <TextBlock Text="✉️  Draft a professional email" TextWrapping="Wrap" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Click="Suggestion_Click"
                    Style="{StaticResource SuggestionButtonStyle}"
                    Tag="Explain how DNS works in simple terms">
                    <TextBlock Text="💡  Explain a concept simply" TextWrapping="Wrap" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="Suggestion_Click"
                    Style="{StaticResource SuggestionButtonStyle}"
                    Tag="Help me plan my day — I have 3 meetings and a deadline tomorrow">
                    <TextBlock Text="📋  Plan my day" TextWrapping="Wrap" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- ── Composer — floating glass card ───────────────────────── -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="800"
            Margin="32,4,32,20"
            HorizontalAlignment="Stretch"
            Spacing="10">

            <!--  Gradient ambient line — pulses during inference  -->
            <Rectangle
                x:Name="ComposerAmbientBar"
                Height="2"
                Fill="{StaticResource GlowGradientBrush}"
                Opacity="0.30"
                RadiusX="1"
                RadiusY="1" />

            <Border
                Background="{StaticResource GlassFillBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXLarge}"
                Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Files queued for the next message — removable chips  -->
                    <ItemsControl
                        Grid.Row="0"
                        Margin="6,4,6,0"
                        ItemsSource="{x:Bind ViewModel.PendingAttachments}"
                        Visibility="{x:Bind ViewModel.HasPendingAttachments, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingAttachment">
                                <Border Style="{StaticResource SourceChipStyle}" ToolTipService.ToolTip="{x:Bind Path}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{StaticResource AccentTextBrush}"
                                            Glyph="{x:Bind controls:FileGlyphs.For(Name)}" />
                                        <TextBlock
                                            MaxWidth="180"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Padding="3"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="RemoveAttachment_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Remove attachment">
                                            <FontIcon
                                                FontSize="9"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                Glyph="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Inline notice — e.g. an image was skipped because the model lacks vision  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="12,6,12,0"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AttachmentNotice, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasAttachmentNotice, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                    <!--  Input — borderless inside the card  -->
                    <TextBox
                        x:Name="InputBox"
                        Grid.Row="2"
                        MinHeight="44"
                        MaxHeight="160"
                        Padding="12,12,12,8"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="15"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        SelectionHighlightColor="{StaticResource AccentBrush}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        KeyDown="InputBox_KeyDown"
                        PlaceholderText="Ask WindowsAI…"
                        Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <!--  Toolbar row  -->
                    <Grid Grid.Row="3" Margin="6,2,2,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                            <!--  Attach files — documents become context, images go to vision models  -->
                            <Button
                                Width="44"
                                Height="44"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="{StaticResource GlassFillBrush}"
                                BorderBrush="{StaticResource GlassStrokeBrush}"
                                BorderThickness="1"
                                Click="Attach_Click"
                                CornerRadius="22"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                ToolTipService.ToolTip="Attach files — documents and images">
                                <FontIcon FontSize="16" Glyph="&#xE723;" />
                            </Button>

                            <!--  Active model pill — mirrors the overlay footer badge  -->
                            <Border Style="{StaticResource ComposerPillStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ModelLabel, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Glyph="{x:Bind ViewModel.ModelGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ModelShortLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!--  Local-RAG toggle: include matching files from this PC.
                                  Shares the model pill's geometry; glass when off, accent when on.  -->
                            <ToggleButton
                                x:Name="LocalContextToggle"
                                Checked="LocalContext_Toggled"
                                Style="{StaticResource ComposerTogglePillStyle}"
                                ToolTipService.ToolTip="Include matching files from this PC as context"
                                Unchecked="LocalContext_Toggled">
                                <ToggleButton.Resources>
                                    <!--  Off (glass)  -->
                                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="GlassFillSubtleBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="GlassHoverBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="GlassPressedBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="GlassStrokeSubtleBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="GlassStrokeSubtleBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="GlassStrokeSubtleBrush" />
                                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextSecondaryBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
                                    <!--  On (accent — mirrors the model badge)  -->
                                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AccentFillSubtleBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AccentFillMediumBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AccentFillMediumBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AccentStrokeBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AccentStrokeBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AccentStrokeBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextBrush" />
                                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextBrush" />
                                </ToggleButton.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                                    <TextBlock VerticalAlignment="Center" Text="Search my PC" />
                                </StackPanel>
                            </ToggleButton>

                            <!--  Live indicator while the local index is being queried  -->
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsSearchingFiles, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <controls:SparkleIcon
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsSearchingFiles, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource AccentTextBrush}"
                                    Text="Searching your PC…"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Keyboard hint  -->
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TextGhostBrush}"
                            Text="Enter to send · Shift+Enter for newline" />

                        <!--  Gradient send button / Stop button (swap on busy)  -->
                        <Grid Grid.Column="2">
                            <Button
                                Command="{x:Bind ViewModel.SendCommand}"
                                Style="{StaticResource GradientCircleButtonStyle}"
                                ToolTipService.ToolTip="Send (Enter)"
                                Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <FontIcon
                                    FontSize="15"
                                    Foreground="White"
                                    Glyph="&#xE724;" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Style="{StaticResource GradientCircleButtonStyle}"
                                ToolTipService.ToolTip="Stop"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="White"
                                    Glyph="&#xE71A;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ── Drag-and-drop affordance — shown while dragging files over the chat ── -->
        <Border
            x:Name="DropAffordance"
            Grid.RowSpan="2"
            Margin="16"
            Background="{StaticResource AccentFillSubtleBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource RadiusXLarge}"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical"
                Spacing="12">
                <FontIcon
                    FontSize="36"
                    Foreground="{StaticResource AccentTextBrush}"
                    Glyph="&#xE8E5;" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Drop files to attach" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Documents become context · images go to vision models" />
            </StackPanel>
        </Border>

    </Grid>
</Page>
